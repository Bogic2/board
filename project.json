{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "lib" ],
  "dependencies": [ "raylib55" ],
  "authors": [ "Bogic Vujadinovic" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  "output": "build",
  "linked-libraries": [ "X11" ],
  "targets": {
    "tabla": {
      "type": "executable",
      "opt": "O2"
    },
    "tabla-debug": {
      "type": "executable",
      "opt": "O0"
    },
    "tabla-e2e": {
      "type": "executable",
      "opt": "O0",
      "features": [ "E2E" ]
    }
  },
  "cpu": "generic"
}
